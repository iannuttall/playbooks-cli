## CLI override endpoints
# PLAYBOOKS_API_URL=http://localhost:3000/api
# PLAYBOOKS_TELEMETRY_URL=http://localhost:3000/api/skill/t
# PLAYBOOKS_INGEST_URL=http://localhost:3000/api/skills/ingest

## Optional shared secret for signed requests
# PLAYBOOKS_TELEMETRY_SECRET=changeme

## Disable telemetry
# PLAYBOOKS_DISABLE_TELEMETRY=1
# DISABLE_TELEMETRY=1
# DO_NOT_TRACK=1
